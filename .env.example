# Copy this file to `.env` and fill in the values for your machine.

# --- Single-scenario battery (scripts/battery) ---
# Absolute path to the directory containing the battery `train.csv` / `test.csv`.
RAW_DATA_DIR=/absolute/path/to/data/raw/battery

# MLflow run ID of the data-generation run holding the pickled simulation config.
DATA_GEN_RUN_ID=48ce4a61104840c58e892006c1bc7880

# --- Multi-scenario battery (scripts/battery_multiple_scenarios) ---
# Absolute path to the directory containing the multi-scenario `train.csv` / `test.csv`.
RAW_DATA_DIR_MULTI=/absolute/path/to/data/raw/battery_multiple_scenarios

# MLflow run ID of the multi-scenario data-generation run holding the pickled config.
DATA_GEN_RUN_ID_MULTI=c83bbf3fa3d54d4eb4202eded159124e
